# Optional legacy root-level ignores: NOT applied automatically by Git.
# Copy these rules to .git/info/exclude in your own checkout if you create
# virtualenvs or output files outside the nested, ignored uploads/build/dist dirs.
# Never commit personal projects, AE snapshots or proprietary plug-ins.

# Local project data and conversion results
/uploads/
*.fcproj
*.prproj
*_conversion_report.md
*_apply_with_bounds.jsx
*_aex_analysis.md
*_shortcuts_report.md
# Generated effect binaries are local except the small, ready-to-load examples.
*.wasm
!/effectcraft_plugins/PixelSorter_EffectCraft.wasm
!/effectcraft_plugins/DeepGlow_EffectCraft.wasm

# Python and Windows build artifacts
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.spec
/FilmCraftConverter.exe
